# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Z1_DOCUMENT_ROOT: directory from which the asset-validation API may read documents.
# Keep this outside public/static directories.
Z1_DOCUMENT_ROOT="data/documents"

# GoBTC Pay POS integration credentials.
# Configure only in the deployment secret store; never commit real values.
GOBTCPAY_API_KEY=""
GOBTCPAY_TERMINAL_ID=""
# Separate Z1-side bearer token, at least 32 random characters.
Z1_GOBTCPAY_GATEWAY_TOKEN=""

# Trust Wallet integration credentials.
# NEVER commit real values. Configure these only in the runtime secret/environment store.
TW_ACCESS_ID=""
TW_HMAC_SECRET=""

# Z1 Diplomatic Family Gateway
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NEVER commit the real key.
Z1_DFG_KEY=""
# Comma-separated stable recipient IDs. Example: family-reem
Z1_DFG_ALLOWED_RECIPIENTS=""
# Optional external HTTPS endpoint. No external contact is made when empty.
Z1_DFG_ENDPOINT=""
# Private audit log path.
Z1_DFG_AUDIT_PATH="data/diplomatic_family_audit.jsonl"

# Z1 humanitarian model gateway and autonomous Council worker.
# Keep disabled until owner, model allowlist, routing evaluation, and secrets are configured.
Z1_MODEL_GATEWAY_TOKEN=""
Z1_MODEL_AUDIT_PATH="data/z1_model_audit.jsonl"
Z1_AGENTS_ENABLED="false"
# Stable private principal identifier; do not use a person's display name.
Z1_AGENT_OWNER_ID=""
Z1_AGENT_STORE_PATH="data/z1_agents.json"
Z1_AGENT_AUDIT_PATH="data/z1_agent_audit.jsonl"
# JSON array of evaluated, approved routing profiles; see Z1_RUNTIME.md.
Z1_MODEL_ROUTING_PROFILES=""
OPENAI_API_KEY=""
XAI_API_KEY=""
ANTHROPIC_API_KEY=""
# GEMINI_API_KEY is declared above.
# Explicit comma-separated allowed model IDs; no default model access.
Z1_OPENAI_MODELS=""
Z1_XAI_MODELS=""
Z1_ANTHROPIC_MODELS=""
Z1_GEMINI_MODELS=""

# NVIDIA NIM API Catalog. Uses an OpenAI-compatible chat-completions endpoint.
# Create the NVIDIA key separately; keep it only in the deployment secret store.
NVIDIA_API_KEY=""
# Comma-separated exact model IDs, e.g. nvidia/nemotron-3-nano-30b-a3b.
Z1_NVIDIA_MODELS=""

# Additional providers — region-specific API keys and explicit allowed model IDs only.
# Qwen currently uses Alibaba Cloud's official US/Virginia DashScope endpoint;
# use a US-region key and review data residency before enabling.
DEEPSEEK_API_KEY=""
DASHSCOPE_API_KEY=""
MOONSHOT_API_KEY=""
ZAI_API_KEY=""
MISTRAL_API_KEY=""
COHERE_API_KEY=""
Z1_DEEPSEEK_MODELS=""
Z1_QWEN_MODELS=""
Z1_KIMI_MODELS=""
Z1_ZHIPU_MODELS=""
Z1_MISTRAL_MODELS=""
Z1_COHERE_MODELS=""
