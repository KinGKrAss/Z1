# Z1 runtime reachable by this connector. Keep the Z1 API private behind TLS.
Z1_API_BASE_URL=https://z1.example.invalid

# Create a separate, high-entropy token for Gemini's access to this read-only MCP.
# Do not reuse a Google, GitHub, banking, or Z1 model-gateway credential.
Z1_MCP_ACCESS_TOKEN=replace-with-a-long-random-secret

# Bind to loopback behind a TLS reverse proxy in production.
HOST=127.0.0.1
PORT=8787
