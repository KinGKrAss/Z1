# Z1 Entranet WireGuard example
# Copy to a protected host configuration; never commit private keys.

[Interface]
Address = 10.42.30.1/24
ListenPort = 51820
# PrivateKey = <LOAD_FROM_SECRET_STORE>

# Example peer
#[Peer]
#PublicKey = <PEER_PUBLIC_KEY>
#AllowedIPs = 10.42.30.2/32
#PersistentKeepalive = 25

# Security rule: private keys must be provisioned outside Git.
